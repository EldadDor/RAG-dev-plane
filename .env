APP_ENV=local
LOG_LEVEL=DEBUG
API_HOST=0.0.0.0
API_PORT=8000

# ---- Vector store selection: postgres | qdrant ----
# Aligned with RAG_Embabel-AI local profile (PostgreSQL + pgvector).
VECTOR_STORE=postgres

# ---- PostgreSQL + pgvector (matches RAG_Embabel-AI local profile) ----
# Points to the laptop Postgres instance where the Java schema already exists.
# For docker-compose local setup, change PG_HOST to: postgres-pgvector
PG_HOST=10.100.102.12
PG_PORT=5432
PG_DATABASE=ragdb
PG_USER=rag_app
PG_PASSWORD=rag_app_password
PG_SSLMODE=disable
PG_USE_ENTRA=false
PG_SCHEMA=rag
PG_TABLE=document_chunks_bge_m3
PG_VECTOR_DIM=1024

# ---- Qdrant (local dev alternative) ----
# QDRANT_URL=http://10.100.102.12:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=developer_docs

# ---- Chat provider ----
CHAT_PROVIDER=openai_compatible
CHAT_BASE_URL=http://127.0.0.1:1234/v1
CHAT_API_KEY=dummy
CHAT_MODEL=dictalm2.0-instruct
CHAT_TIMEOUT_SECONDS=240
CHAT_MAX_TOKENS=400
CHAT_THINK=false
EMBEDDING_TIMEOUT_SECONDS=120

# ---- Embedding provider (matches RAG_Embabel-AI local profile) ----
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://10.100.102.12:11434
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3:latest

TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RERANK_ENABLED=false
