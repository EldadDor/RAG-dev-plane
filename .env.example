APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ---- Authenticated principal ----
# Local mode uses a fixed server-side identity. Office deployments must use
# AUTH_MODE=gateway and allow traffic only through the identity-injecting gateway.
AUTH_MODE=local
LOCAL_SUBJECT=local-dev
LOCAL_DISPLAY_NAME=Local Developer
LOCAL_EMAIL=dev@localhost
CHAT_IDENTITY_HEADER=X-Forwarded-User
CHAT_IDENTITY_NAME_HEADER=X-Forwarded-Name
CHAT_IDENTITY_EMAIL_HEADER=X-Forwarded-Email

# ---- Observability (optional Langfuse) ----
# Keep disabled until office credentials and data-capture policy are approved.
LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Never enable raw question/prompt/document capture without explicit approval.
LANGFUSE_CAPTURE_CONTENT=false

# ---- Vector store selection: postgres | qdrant ----
# Default matches RAG_Embabel-AI local profile (PostgreSQL + pgvector).
VECTOR_STORE=postgres

# ---- PostgreSQL + pgvector (matches RAG_Embabel-AI local profile) ----
# For docker-compose local setup:
PG_HOST=postgres-pgvector
PG_PORT=5432
PG_DATABASE=ragdb
PG_USER=rag_app
PG_PASSWORD=rag_app_password
PG_SSLMODE=disable
PG_USE_ENTRA=false
PG_SCHEMA=rag
PG_TABLE=document_chunks
PG_VECTOR_DIM=768
# Used by local mode and as the default workspace for ingestion requests.
DEFAULT_WORKSPACE_ID=local

# ---- Qdrant (local dev alternative) ----
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=developer_docs
QDRANT_CHECK_COMPATIBILITY=true

# ---- Chat provider: openai_compatible | azure_openai ----
CHAT_PROVIDER=openai_compatible
CHAT_BASE_URL=http://10.100.102.12:8080/v1
CHAT_API_KEY=dummy
CHAT_MODEL=qwen2.5:7b-instruct-q4_K_M
CHAT_TIMEOUT_SECONDS=240
CHAT_MAX_TOKENS=400
# Ollama-compatible thinking; keep false for normal RAG answers.
CHAT_THINK=false

# ---- Embedding provider: ollama | azure_openai ----
# Default matches RAG_Embabel-AI local profile (nomic-embed-text = 768 dims).
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_TIMEOUT_SECONDS=120

# ---- Azure OpenAI (shared by chat + embeddings when using azure_openai) ----
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_USE_ENTRA=false

# ---- RAG tuning ----
TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RERANK_ENABLED=false
MIN_RETRIEVAL_SCORE=0.35
HYBRID_SEARCH_ENABLED=true
RETRIEVAL_CANDIDATE_K=20
RRF_K=60

# ---- Conversation memory ----
MEMORY_MAX_TURNS=10
MEMORY_RETENTION_DAYS=90
MEMORY_SUMMARY_AFTER_TURNS=8
